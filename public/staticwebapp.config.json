{
  "routes": [
    { "route": "/FantasyFootballWebsite", "redirect": "https://flambeaurivertours.github.io/FantasyFootballWebsite/", "statusCode": 301 },
    { "route": "/FantasyFootballWebsite/*", "redirect": "https://flambeaurivertours.github.io/FantasyFootballWebsite/", "statusCode": 301 },
    { "route": "/dailyDriver", "redirect": "https://flambeaurivertours.github.io/dailyDriver/", "statusCode": 301 },
    { "route": "/dailyDriver/*", "redirect": "https://flambeaurivertours.github.io/dailyDriver/", "statusCode": 301 },
